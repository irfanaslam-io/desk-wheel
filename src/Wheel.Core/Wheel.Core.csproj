<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wheel.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The JSON viewer page (self-contained: no internet, nothing loaded from elsewhere). -->
    <EmbeddedResource Include="Json\JsonViewer.html" LogicalName="Wheel.Core.Json.JsonViewer.html" />
    <EmbeddedResource Include="Pdf\GlyphlessFont.ttf" LogicalName="Wheel.Core.Pdf.GlyphlessFont.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- QR codes and barcodes: reading from the screen and making new ones (Apache-2.0, pure .NET). -->
    <PackageReference Include="DiscUtils.Iso9660" Version="0.16.13" />
    <PackageReference Include="SharpCompress" Version="0.50.8" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <!-- PDF passwords and compression, in-process (MIT): nothing extra to install. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp's signing dependency, pinned to the release with the security fix. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

</Project>
