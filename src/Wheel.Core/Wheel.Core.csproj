<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wheel.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- QR codes and barcodes: reading from the screen and making new ones (Apache-2.0, pure .NET). -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <!-- PDF passwords and compression, in-process (MIT): nothing extra to install. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp's signing dependency, pinned to the release with the security fix. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

</Project>
