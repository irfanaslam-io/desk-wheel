<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store package for Desk Wheel. build.ps1 -Msix fills in the {TOKENS}:
  {NAME}, {PUBLISHER} and {PUBLISHER_NAME} come from Partner Center › your app › Product identity
  (irfanaslam.io.DeskWheel / CN=E17FA43C-D005-44B0-BA35-1A38B8D60FD6 / irfanaslam.io, built into build.ps1;
  WHEEL_MSIX_* override them); {VERSION} is <Version>.0. Package family name: irfanaslam.io.DeskWheel_69qks97mj3kmy.
  The Store signs the package, so Windows trusts it fully (no Smart App Control or SmartScreen prompts).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  IgnorableNamespaces="uap desktop rescap uap3">

  <Identity Name="{NAME}" Publisher="{PUBLISHER}" Version="{VERSION}" ProcessorArchitecture="{ARCH}" />

  <Properties>
    <DisplayName>Desk Wheel</DisplayName>
    <PublisherDisplayName>{PUBLISHER_NAME}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Drop it. Turn it. Done. Convert files, take and mark up screenshots, and keep a clipboard history, all offline.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="DeskWheel" Executable="DeskWheel.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Desk Wheel" Description="Drop it. Turn it. Done."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Desk Wheel" />
      </uap:VisualElements>
      <Extensions>
        <!-- Starts in the background at sign-in (users switch it in Settings › Apps › Startup). -->
        <desktop:Extension Category="windows.startupTask" Executable="DeskWheel.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DeskWheelAtSignIn" Enabled="true" DisplayName="Desk Wheel" />
        </desktop:Extension>
        <!-- "Open with > Desk Wheel" for every type it opens (people choose it as their default in Settings if they want). -->
        <!-- file types: begin (scripts/file-associations.py) -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="pictures" Parameters="--open &quot;%1&quot;">
            <uap:DisplayName>Picture</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.heic</uap:FileType>
              <uap:FileType>.heif</uap:FileType>
              <uap:FileType>.avif</uap:FileType>
              <uap:FileType>.tif</uap:FileType>
              <uap:FileType>.tiff</uap:FileType>
              <uap:FileType>.ico</uap:FileType>
              <uap:FileType>.jfif</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="videos" Parameters="--open &quot;%1&quot;">
            <uap:DisplayName>Video</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.mp4</uap:FileType>
              <uap:FileType>.m4v</uap:FileType>
              <uap:FileType>.mov</uap:FileType>
              <uap:FileType>.mkv</uap:FileType>
              <uap:FileType>.avi</uap:FileType>
              <uap:FileType>.webm</uap:FileType>
              <uap:FileType>.wmv</uap:FileType>
              <uap:FileType>.flv</uap:FileType>
              <uap:FileType>.3gp</uap:FileType>
              <uap:FileType>.mts</uap:FileType>
              <uap:FileType>.m2ts</uap:FileType>
              <uap:FileType>.mpg</uap:FileType>
              <uap:FileType>.mpeg</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="music" Parameters="--open &quot;%1&quot;">
            <uap:DisplayName>Audio</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.mp3</uap:FileType>
              <uap:FileType>.m4a</uap:FileType>
              <uap:FileType>.aac</uap:FileType>
              <uap:FileType>.wav</uap:FileType>
              <uap:FileType>.flac</uap:FileType>
              <uap:FileType>.ogg</uap:FileType>
              <uap:FileType>.oga</uap:FileType>
              <uap:FileType>.opus</uap:FileType>
              <uap:FileType>.wma</uap:FileType>
              <uap:FileType>.aiff</uap:FileType>
              <uap:FileType>.aif</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="pdf" Parameters="--open &quot;%1&quot;">
            <uap:DisplayName>PDF document</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="archives" Parameters="--open &quot;%1&quot;">
            <uap:DisplayName>Archive</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.zip</uap:FileType>
              <uap:FileType>.rar</uap:FileType>
              <uap:FileType>.7z</uap:FileType>
              <uap:FileType>.iso</uap:FileType>
              <uap:FileType>.tar</uap:FileType>
              <uap:FileType>.gz</uap:FileType>
              <uap:FileType>.tgz</uap:FileType>
              <uap:FileType>.bz2</uap:FileType>
              <uap:FileType>.tbz2</uap:FileType>
              <uap:FileType>.xz</uap:FileType>
              <uap:FileType>.txz</uap:FileType>
              <uap:FileType>.cbz</uap:FileType>
              <uap:FileType>.cbr</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="text" Parameters="--open &quot;%1&quot;">
            <uap:DisplayName>Markdown or JSON</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
              <uap:FileType>.json</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap:Extension>
        <!-- file types: end -->
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A regular desktop app: screenshots, the floating button and file conversion need full trust. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
